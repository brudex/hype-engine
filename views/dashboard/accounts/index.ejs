                                            <div class="mb-3" ng-repeat="field in accountsCtrl.getFormFields('tiktok')">
                                                <label class="form-label">{{ field.fieldLabel }} <span class="text-danger">*</span></label>
                                                <input ng-if="field.fieldType === 'text'" type="text" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <input ng-if="field.fieldType === 'password'" type="password" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <select ng-if="field.fieldType === 'select'" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                    <option value="">Select...</option>
                                                    <option ng-repeat="opt in field.options" value="{{ opt }}">{{ opt }}</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="active" value="true" id="acc-active-tiktok" checked>
                                                    <label class="form-check-label" for="acc-active-tiktok">Activate this service</label>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-primary" ng-disabled="accountsCtrl.savingApiKey && accountsCtrl.savingApiKey['tiktok']">{{ (accountsCtrl.savingApiKey && accountsCtrl.savingApiKey['tiktok']) ? 'Saving...' : 'Save Configuration' }}</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Mastodon -->
                    <div class="tab-pane fade" id="acc-platform-mastodon" role="tabpanel">
                        <div class="card">
                            <div class="card-body">
                                <div class="btn-group mb-3" role="tablist">
                                    <button type="button" id="tab-acc-mastodon-oauth" class="btn btn-outline-primary active" data-bs-toggle="tab" data-bs-target="#acc-mastodon-oauth" role="tab" aria-selected="true"><i class="bi bi-link-45deg"></i> Connect via OAuth</button>
                                    <button type="button" id="tab-acc-mastodon-apikeys" class="btn btn-outline-primary" data-bs-toggle="tab" data-bs-target="#acc-mastodon-apikeys" role="tab" aria-selected="false"><i class="bi bi-key"></i> Connect with API keys</button>
                                </div>
                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="acc-mastodon-oauth" role="tabpanel">
                                        <h5 class="card-title"><i class="bi bi-mastodon text-primary"></i> Mastodon</h5>
                                        <p class="text-theme-secondary">Connect your Mastodon accounts to this project.</p>
                                        <div ng-if="accountsCtrl.getPlatformAccounts('mastodon').length > 0">
                                            <div class="list-group mb-3">
                                                <div class="list-group-item d-flex justify-content-between align-items-center" ng-repeat="account in accountsCtrl.getPlatformAccounts('mastodon')">
                                                    <div><h6 class="mb-0">{{ account.name }}</h6><small class="text-muted">{{ account.username || 'N/A' }}</small></div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge" ng-class="account.authorized ? 'bg-success' : 'bg-warning'">{{ account.authorized ? 'Authorized' : 'Unauthorized' }}</span>
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <li><a class="dropdown-item" href="#" ng-click="accountsCtrl.refreshAccount(account.uuid); $event.preventDefault()"><i class="bi bi-arrow-clockwise me-2"></i> Refresh</a></li>
                                                                <li><a class="dropdown-item text-danger" href="#" ng-click="accountsCtrl.deleteAccount(account.uuid); $event.preventDefault()"><i class="bi bi-trash me-2"></i> Delete</a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <button class="btn btn-primary" ng-click="accountsCtrl.connectAccount('mastodon')"><i class="bi bi-plus-circle"></i> Connect Mastodon Account</button>
                                    </div>
                                    <div class="tab-pane fade" id="acc-mastodon-apikeys" role="tabpanel">
                                        <div class="alert alert-info mb-3" role="alert">Authorize connection of your Mastodon with API keys.</div>
                                        <form ng-submit="accountsCtrl.saveApiKeyConfig('mastodon', $event)">
                                            <div class="mb-3" ng-repeat="field in accountsCtrl.getFormFields('mastodon')">
                                                <label class="form-label">{{ field.fieldLabel }} <span class="text-danger">*</span></label>
                                                <input ng-if="field.fieldType === 'text'" type="text" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <input ng-if="field.fieldType === 'password'" type="password" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <select ng-if="field.fieldType === 'select'" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                    <option value="">Select...</option>
                                                    <option ng-repeat="opt in field.options" value="{{ opt }}">{{ opt }}</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="active" value="true" id="acc-active-mastodon" checked>
                                                    <label class="form-check-label" for="acc-active-mastodon">Activate this service</label>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-primary" ng-disabled="accountsCtrl.savingApiKey && accountsCtrl.savingApiKey['mastodon']">{{ (accountsCtrl.savingApiKey && accountsCtrl.savingApiKey['mastodon']) ? 'Saving...' : 'Save Configuration' }}</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/scripts/app/accounts.client.controller.js"></script>
