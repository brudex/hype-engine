                </button>
            </div>
            <div class="code-block" id="delete-tag-url">
                <pre><code>DELETE /api/v1/:projectUuid/tags/:tagUuid</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Response</h3>
        <p><strong>Success (200):</strong></p>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Success Response</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('delete-tag-success')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="delete-tag-success">
                <pre><code>{
  "success": true,
  "message": "Tag deleted successfully"
}</code></pre>
