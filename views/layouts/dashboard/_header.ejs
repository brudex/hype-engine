<header class="dashboard-header">
    <div class="header-content">
        <div class="header-left">
            <button class="mobile-menu-toggle d-md-none" id="mobile-collapse" type="button">
                <i class="bi bi-list"></i>
            </button>
            <a href="/dashboard" class="header-logo">
                <span class="logo-text">Mixpost</span>
            </a>
        </div>
        <div class="header-right">
            <div class="user-profile-dropdown">
                <button class="user-profile-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="user-name"><%= typeof user !== 'undefined' && user ? (user.fullName || user.email) : 'Guest' %></span>
                    <i class="bi bi-chevron-down"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end profile-dropdown-menu">
                    <li>
                        <a class="dropdown-item" href="/dashboard/settings">
                            <i class="bi bi-gear me-2"></i> Settings
                        </a>
                    </li>
                    <li>
                        <a class="dropdown-item" href="#!">
                            <i class="bi bi-person me-2"></i> Profile
                        </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item" href="/auth/logout">
                            <i class="bi bi-box-arrow-right me-2"></i> Logout
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
