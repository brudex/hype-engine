<% var ctrl = typeof previewCtrl !== 'undefined' ? previewCtrl : 'postsCtrl'; %>
<!-- Post Preview Modal -->
<div class="modal fade" 
     id="postPreviewModal" 
     tabindex="-1" 
     aria-labelledby="postPreviewModalLabel" 
     aria-hidden="true"
     ng-class="{'show': <%= ctrl %>.showPreview, 'd-block': <%= ctrl %>.showPreview}"
     ng-style="{'display': <%= ctrl %>.showPreview ? 'block' : 'none'}"
     style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="postPreviewModalLabel">
                    <span class="badge" ng-class="<%= ctrl %>.getStatusClass(<%= ctrl %>.previewPost.status)" ng-if="<%= ctrl %>.previewPost">
                        {{ <%= ctrl %>.getStatusText(<%= ctrl %>.previewPost.status) }}
                    </span>
                </h5>
                <button type="button" 
                        class="btn-close" 
                        ng-click="<%= ctrl %>.closePreview()"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body" ng-if="<%= ctrl %>.previewPost">
                <div ng-repeat="account in <%= ctrl %>.previewPost.accounts" class="mb-4">
                    <div ng-init="accountVersion = <%= ctrl %>.getAccountVersion(<%= ctrl %>.previewPost, account)">
                        <div ng-switch="account.provider">
                            <div ng-switch-when="twitter">
                                <twitter-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="<%= ctrl %>.getPlainText(html)">
                                </twitter-preview>
                            </div>
                            <div ng-switch-when="facebook">
                                <facebook-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="<%= ctrl %>.getPlainText(html)">
                                </facebook-preview>
                            </div>
                            <div ng-switch-when="instagram">
                                <instagram-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="<%= ctrl %>.getPlainText(html)">
                                </instagram-preview>
                            </div>
                            <div ng-switch-when="linkedin">
                                <linkedin-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="<%= ctrl %>.getPlainText(html)">
                                </linkedin-preview>
                            </div>
                            <div ng-switch-when="tiktok">
                                <tiktok-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="<%= ctrl %>.getPlainText(html)">
                                </tiktok-preview>
                            </div>
                            <div ng-switch-when="mastodon">
                                <mastodon-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="<%= ctrl %>.getPlainText(html)">
                                </mastodon-preview>
                            </div>
                            <div ng-switch-default>
                                <div class="preview-post-card">
                                    <div class="preview-account-header">
                                        <div class="preview-account-avatar-wrapper">
                                            <img ng-if="account.image" 
                                                 ng-src="{{ account.image }}" 
                                                 alt="{{ account.name }}"
                                                 class="preview-account-avatar">
                                            <div ng-if="!account.image" 
                                                 class="preview-account-avatar preview-account-avatar-placeholder">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        </div>
                                        <div class="preview-account-info">
                                            <div class="preview-account-name">{{ account.name }}</div>
                                            <div class="preview-account-username" ng-if="account.username">@{{ account.username }}</div>
                                            <div class="preview-account-timestamp">now</div>
                                        </div>
                                    </div>
                                    <div ng-if="accountVersion" class="preview-post-body">
                                        <div class="preview-post-text" ng-if="accountVersion.body">
                                            {{ <%= ctrl %>.getPlainText(accountVersion.body) }}
                                        </div>
                                        <div ng-if="!accountVersion.body" class="preview-post-text-placeholder">
                                            Start typing your post...
                                        </div>
                                        <div ng-if="accountVersion.media && accountVersion.media.length > 0" class="preview-media-container">
                                            <div class="preview-media-grid preview-media-single">
                                                <img ng-src="{{ accountVersion.media[0].url }}" 
                                                     alt="Media"
                                                     class="preview-media-image">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" 
                        class="btn btn-secondary" 
                        ng-click="<%= ctrl %>.closePreview()">
                    Close
                </button>
                <button type="button" 
                        class="btn btn-primary" 
                        ng-click="<%= ctrl %>.editPost(<%= ctrl %>.previewPost.uuid)"
                        ng-if="<%= ctrl %>.previewPost">
                    <i class="bi bi-pencil"></i> Edit
                </button>
            </div>
        </div>
    </div>
</div>
