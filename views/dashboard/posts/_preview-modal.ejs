<!-- Post Preview Modal -->
<div class="modal fade" 
     id="postPreviewModal" 
     tabindex="-1" 
     aria-labelledby="postPreviewModalLabel" 
     aria-hidden="true"
     ng-class="{'show': postsCtrl.showPreview, 'd-block': postsCtrl.showPreview}"
     ng-style="{'display': postsCtrl.showPreview ? 'block' : 'none'}"
     style="background-color: rgba(0,0,0,0.5);">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="postPreviewModalLabel">
                    <span class="badge" ng-class="postsCtrl.getStatusClass(postsCtrl.previewPost.status)" ng-if="postsCtrl.previewPost">
                        {{ postsCtrl.getStatusText(postsCtrl.previewPost.status) }}
                    </span>
                </h5>
                <button type="button" 
                        class="btn-close" 
                        ng-click="postsCtrl.closePreview()"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body" ng-if="postsCtrl.previewPost">
                <!-- Post Preview Content - Using Platform-Specific Previews -->
                <div ng-repeat="account in postsCtrl.previewPost.accounts" class="mb-4">
                    <div ng-init="accountVersion = postsCtrl.getAccountVersion(postsCtrl.previewPost, account)">
                        <!-- Platform-specific previews using ng-switch -->
                        <div ng-switch="account.provider">
                            <!-- Twitter Preview -->
                            <div ng-switch-when="twitter">
                                <twitter-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="postsCtrl.getPlainText(html)">
                                </twitter-preview>
                            </div>
                            
                            <!-- Facebook Preview -->
                            <div ng-switch-when="facebook">
                                <facebook-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="postsCtrl.getPlainText(html)">
                                </facebook-preview>
                            </div>
                            
                            <!-- Instagram Preview -->
                            <div ng-switch-when="instagram">
                                <instagram-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="postsCtrl.getPlainText(html)">
                                </instagram-preview>
                            </div>
                            
                            <!-- LinkedIn Preview -->
                            <div ng-switch-when="linkedin">
                                <linkedin-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="postsCtrl.getPlainText(html)">
                                </linkedin-preview>
                            </div>
                            
                            <!-- TikTok Preview -->
                            <div ng-switch-when="tiktok">
                                <tiktok-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="postsCtrl.getPlainText(html)">
                                </tiktok-preview>
                            </div>
                            
                            <!-- Mastodon Preview -->
                            <div ng-switch-when="mastodon">
                                <mastodon-preview 
                                    account="account" 
                                    content="accountVersion"
                                    get-plain-text="postsCtrl.getPlainText(html)">
                                </mastodon-preview>
                            </div>
                            
                            <!-- Default Preview (fallback for unknown providers) -->
                            <div ng-switch-default>
                                <div class="preview-post-card">
                                    <div class="preview-account-header">
                                        <div class="preview-account-avatar-wrapper">
                                            <img ng-if="account.image" 
                                                 ng-src="{{ account.image }}" 
                                                 alt="{{ account.name }}"
                                                 class="preview-account-avatar">
                                            <div ng-if="!account.image" 
                                                 class="preview-account-avatar preview-account-avatar-placeholder">
                                                <i class="bi bi-person"></i>
                                            </div>
                                        </div>
                                        <div class="preview-account-info">
                                            <div class="preview-account-name">{{ account.name }}</div>
                                            <div class="preview-account-username" ng-if="account.username">@{{ account.username }}</div>
                                            <div class="preview-account-timestamp">now</div>
                                        </div>
                                    </div>
                                    <div ng-if="accountVersion" class="preview-post-body">
                                        <div class="preview-post-text" ng-if="accountVersion.body">
                                            {{ postsCtrl.getPlainText(accountVersion.body) }}
                                        </div>
                                        <div ng-if="!accountVersion.body" class="preview-post-text-placeholder">
                                            Start typing your post...
                                        </div>
                                        <div ng-if="accountVersion.media && accountVersion.media.length > 0" class="preview-media-container">
                                            <div class="preview-media-grid preview-media-single">
                                                <img ng-src="{{ accountVersion.media[0].url }}" 
                                                     alt="Media"
                                                     class="preview-media-image">
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" 
                        class="btn btn-secondary" 
                        ng-click="postsCtrl.closePreview()">
                    Close
                </button>
                <button type="button" 
                        class="btn btn-primary" 
                        ng-click="postsCtrl.editPost(postsCtrl.previewPost.uuid)"
                        ng-if="postsCtrl.previewPost">
                    <i class="bi bi-pencil"></i> Edit
                </button>
            </div>
        </div>
    </div>
</div>

