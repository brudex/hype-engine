<!-- Form Fields -->
<div class="mb-3">
    <label for="client_id" class="form-label">Access Key <span class="text-danger">*</span></label>
    <input type="text" class="form-control" id="client_id" name="configuration[client_id]" required>
    <small class="form-text text-muted">Your Unsplash Access Key</small>
</div>

<!-- Help Section -->
<div class="card mt-3">
    <div class="card-body">
        <h6 class="card-title">How to get API credentials</h6>
        <ul class="small">
            <li>Go to <a href="https://unsplash.com/developers" target="_blank">Unsplash Developers</a></li>
            <li>Create a new application</li>
            <li>Copy your Access Key</li>
        </ul>
    </div>
</div>
