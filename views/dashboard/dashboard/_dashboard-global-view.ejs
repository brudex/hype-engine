<div ng-if="!vm.loading && vm.currentView === 'global'" class="dashboard-view-global">
    <!-- Global Metrics Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-icon metric-icon-accounts">
                        <i class="bi bi-person-circle"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" ng-if="vm.globalMetrics">
                            {{ vm.globalMetrics.metrics.totalAccounts }}
                        </div>
                        <div class="metric-label">Total Accounts</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-icon metric-icon-scheduled">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" ng-if="vm.globalMetrics">
                            {{ vm.globalMetrics.metrics.scheduledPosts }}
                        </div>
                        <div class="metric-label">Scheduled Posts</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-icon metric-icon-published">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" ng-if="vm.globalMetrics">
                            {{ vm.globalMetrics.metrics.publishedPosts }}
                        </div>
                        <div class="metric-label">Published Posts</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="metric-card card">
                <div class="card-body">
                    <div class="metric-icon metric-icon-alerts">
                        <i class="bi bi-exclamation-triangle"></i>
                    </div>
                    <div class="metric-content">
                        <div class="metric-value" ng-if="vm.globalMetrics">
                            {{ vm.globalMetrics.metrics.unauthorizedAccounts }}
                        </div>
                        <div class="metric-label">Needs Attention</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Projects Summary -->
    <div class="card">
        <div class="card-header">
            <h5 class="mb-0 text-theme-primary">
                <i class="bi bi-folder me-2"></i>Projects Overview
            </h5>
        </div>
        <div class="card-body">
            <div ng-if="vm.globalMetrics && vm.globalMetrics.projects.length === 0" class="empty-state text-center py-5">
                <div class="empty-state-icon mb-3">
                    <i class="bi bi-folder-x"></i>
                </div>
                <h5 class="text-theme-primary mb-2">No projects yet</h5>
                <a href="/dashboard/projects/create" class="btn btn-accent-cyan">
                    <i class="bi bi-plus-circle me-2"></i>Create Your First Project
                </a>
            </div>

            <div ng-if="vm.globalMetrics && vm.globalMetrics.projects.length > 0" class="projects-grid">
                <div class="project-summary-card card" 
                     ng-repeat="project in vm.globalMetrics.projects"
                     ng-click="vm.selectProject(project)">
                    <div class="card-body">
                        <div class="d-flex align-items-center">
                            <div class="project-summary-icon me-3">
                                <div ng-if="project.imageUrl" class="project-icon-image">
                                    <img ng-src="{{ project.imageUrl }}" alt="{{ project.name }}">
                                </div>
                                <div ng-if="!project.imageUrl" class="project-icon-initials">
                                    {{ vm.getProjectInitials(project.name) }}
                                </div>
                            </div>
                            <div class="flex-grow-1">
                                <h6 class="mb-1 text-theme-primary">
                                    {{ project.name }}
                                    <span ng-if="project.needsAttention" class="badge badge-sm badge-warning ms-1">
                                        <i class="bi bi-exclamation-triangle"></i>
                                    </span>
                                </h6>
                                <p class="text-theme-secondary small mb-0" ng-if="project.description">
                                    {{ project.description }}
                                </p>
                            </div>
                            <div class="project-summary-stats text-end">
                                <div class="stat-item">
                                    <i class="bi bi-person-circle"></i>
                                    <span>{{ project.accountCount }}</span>
                                </div>
                                <div class="stat-item">
                                    <i class="bi bi-file-post"></i>
                                    <span>{{ project.postCount }}</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>