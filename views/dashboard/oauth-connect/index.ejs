<div class="page-header mb-0">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h4 class="m-b-5 text-theme-primary">OAuth Connect</h4>
                    <p class="text-theme-secondary mb-0">Configure app-wide OAuth credentials for connecting social accounts</p>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item active">OAuth Connect</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="main-body mt-0" ng-controller="OauthConnectController as oauthConnectCtrl" ng-init="oauthConnectCtrl.init()">
    <div class="page-wrapper">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i>
            <strong>Important:</strong> Configure OAuth services here for the whole app. These credentials are used when connecting social accounts from any project.
        </div>

        <div ng-if="oauthConnectCtrl.loading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <div ng-if="!oauthConnectCtrl.loading">
            <h5 class="mb-3 text-theme-primary">
                <i class="bi bi-share"></i> Social Platform OAuth
            </h5>
            <p class="text-secondary small mb-3">Configure OAuth applications for social media platforms (app-wide)</p>

            <div class="row">
                <div class="col-md-6 mb-4" ng-repeat="service in oauthConnectCtrl.services">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="bi" ng-class="{
                                            'bi-twitter text-primary': service.name === 'twitter',
                                            'bi-facebook text-primary': service.name === 'facebook',
                                            'bi-instagram text-danger': service.name === 'instagram',
                                            'bi-linkedin text-primary': service.name === 'linkedin',
                                            'bi-mastodon text-primary': service.name === 'mastodon',
                                            'bi-tiktok': service.name === 'tiktok',
                                            'bi-image': service.name === 'unsplash',
                                            'bi-file-play': service.name === 'tenor'
                                        }"></i>
                                        {{ oauthConnectCtrl.capitalize(service.name) }}
                                    </h5>
                                    <p class="text-secondary small mb-0 mt-2">Configure {{ service.name }} OAuth credentials</p>
                                </div>
                                <span class="badge" ng-class="oauthConnectCtrl.getServiceStatus(service)">
                                    {{ service.configured ? 'Configured' : 'Not Configured' }}
                                </span>
                            </div>
                            <p class="text-secondary small mt-0">
                                Required for connecting {{ service.name }} accounts.
                            </p>
                            <button class="btn btn-sm btn-outline-primary" ng-click="oauthConnectCtrl.configureService(service.name)">
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/scripts/app/oauth-connect.client.controller.js"></script>
