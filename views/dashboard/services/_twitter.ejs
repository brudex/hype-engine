<!-- Form Fields -->
<div class="mb-3">
    <label for="client_id" class="form-label">API Key (Client ID) <span class="text-danger">*</span></label>
    <input type="text" class="form-control" id="client_id" name="configuration[client_id]" required>
    <small class="form-text text-muted">Your Twitter API Key</small>
</div>

<div class="mb-3">
    <label for="client_secret" class="form-label">API Secret (Client Secret) <span class="text-danger">*</span></label>
    <input type="password" class="form-control" id="client_secret" name="configuration[client_secret]" required>
    <small class="form-text text-muted">Your Twitter API Secret</small>
</div>

<div class="mb-3">
    <label for="tier" class="form-label">Tier <span class="text-danger">*</span></label>
    <select class="form-control" id="tier" name="configuration[tier]" required>
        <option value="free">Free</option>
        <option value="basic">Basic</option>
        <option value="legacy">Legacy</option>
    </select>
    <small class="form-text text-muted">Your Twitter API tier</small>
</div>

<div class="mb-3">
    <button type="button" class="btn btn-outline-info" ng-click="configCtrl.testCredentials()" ng-disabled="configCtrl.testing">
        <i class="bi" ng-class="configCtrl.testing ? 'bi-hourglass-split' : 'bi-check-circle'"></i>
        {{ configCtrl.testing ? 'Testing...' : 'Test Credentials' }}
    </button>
    <small class="form-text text-muted d-block mt-1">Test if your API credentials are valid</small>
</div>

<!-- Help Section -->
<div class="card mt-3">
    <div class="card-body">
        <h6 class="card-title">How to get API credentials</h6>
        <ul class="small">
            <li>Go to <a href="https://developer.twitter.com" target="_blank">Twitter Developer Portal</a></li>
            <li>Create a new app or use an existing one</li>
            <li>Navigate to "Keys and tokens" section</li>
            <li>Copy your API Key and API Secret</li>
        </ul>
    </div>
</div>
