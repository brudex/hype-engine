<!DOCTYPE html>
<html lang="en">

<head>
    <title><%= typeof title !== 'undefined' ? title : 'Mixpost' %> - Social Media Management</title>
    <!-- Meta -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="Mixpost - Social Media Management Platform">
    <meta name="keywords" content="Mixpost, Social Media, Management, Automation">
    <meta name="author" content="Mixpost">
    <!-- Favicon icon -->
    <link rel="icon" href="/assets/images/favicon.ico" type="image/x-icon">
    <!-- Google font-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" type="text/css" href="/bootstrap-5.3.8/css/bootstrap.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="/css/theme.css">
    <%- typeof style !== 'undefined' ? style : '' %>
</head>

<body class="content-page-body">
    <div class="content-page-container">
        <!-- Header -->
        <header class="content-page-header">
            <div class="container">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="content-logo">
                        <a href="/">
                            <h1 class="mb-0">Mixpost</h1>
                        </a>
                    </div>
                    <nav class="content-page-nav">
                        <a href="/auth/login" class="btn btn-outline-primary btn-sm">Login</a>
                    </nav>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="content-page-main">
            <div class="container">
                <%- body %>
            </div>
        </main>

        <!-- Footer -->
        <footer class="content-page-footer">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <p class="mb-0">&copy; <%= new Date().getFullYear() %> Mixpost. All rights reserved.</p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <a href="/terms" class="text-decoration-none me-3">Terms of Service</a>
                        <a href="/privacy-policy" class="text-decoration-none">Privacy Policy</a>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
    <%- typeof script !== 'undefined' ? script : '' %>

    <style>
        .content-page-body {
            background: var(--theme-primary, #1a1a1a);
            color: var(--theme-text-primary, #ffffff);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .content-page-container {
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .content-page-header {
            background: var(--theme-secondary, #252525);
            border-bottom: 1px solid var(--theme-border, rgba(255, 255, 255, 0.1));
            padding: 1.5rem 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .content-logo h1 {
            background: linear-gradient(135deg, #00EFFF 0%, #8B5CF6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            font-size: 1.75rem;
            font-weight: 700;
            text-decoration: none;
        }

        .content-logo a {
            text-decoration: none;
        }

        .content-page-main {
            flex: 1;
            padding: 3rem 0;
        }

        .content-page-footer {
            background: var(--theme-secondary, #252525);
            border-top: 1px solid var(--theme-border, rgba(255, 255, 255, 0.1));
            padding: 2rem 0;
            margin-top: auto;
        }

        .content-page-footer a {
            color: var(--theme-text-secondary, #cccccc);
            transition: color 0.2s ease;
        }

        .content-page-footer a:hover {
            color: var(--theme-accent-cyan, #00EFFF);
        }

        @media (max-width: 768px) {
            .content-page-main {
                padding: 2rem 0;
            }

            .content-page-footer .text-md-end {
                text-align: left !important;
                margin-top: 1rem;
            }
        }
    </style>
</body>

</html>

