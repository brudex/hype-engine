<link rel="stylesheet" type="text/css" href="/css/jobs.css">

<div class="page-header mb-0">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h4 class="m-b-5 text-theme-primary">Job Batches</h4>
                    <p class="text-theme-secondary mb-0">View and monitor background job execution</p>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                    <li class="breadcrumb-item active">Jobs</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="main-body mt-0" ng-controller="JobsController as jobsCtrl" ng-init="jobsCtrl.init()">
    <div class="page-wrapper">
        <div class="container-fluid">
            <!-- Filters -->
            <div class="card mb-4" style="border: 1px solid var(--theme-border); background: var(--theme-secondary);">
                <div class="card-body">
                    <form class="row g-3" ng-submit="jobsCtrl.fetchJobs(); $event.preventDefault();">
                        <div class="col-md-4">
                            <label class="form-label text-theme-secondary" style="font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Status</label>
                            <select name="status" 
                                    class="form-select" 
                                    ng-model="jobsCtrl.filters.status"
                                    ng-change="jobsCtrl.currentPage = 1; jobsCtrl.fetchJobs();"
                                    style="background: var(--theme-primary); border: 1px solid var(--theme-border); color: var(--theme-text-primary);">
                                <option value="">All Status</option>
                                <option value="active">Active</option>
                                <option value="completed">Completed</option>
                                <option value="failed">Failed</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label" style="visibility: hidden;">&nbsp;</label>
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Jobs Table -->
            <div class="card" style="border: 1px solid var(--theme-border); background: var(--theme-secondary);">
                <div class="card-header d-flex justify-content-between align-items-center" style="background: transparent; border-bottom: 1px solid var(--theme-border); padding: 16px 24px;">
                    <h5 class="mb-0 text-theme-primary" style="font-weight: 600;">
                        Job Batches <span class="text-theme-secondary" style="font-weight: 400;">(<span ng-if="jobsCtrl.pagination">{{ jobsCtrl.pagination.totalItems.toLocaleString() }}</span><span ng-if="!jobsCtrl.pagination">-</span>)</span>
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 50000px; overflow-y: auto;">
                        <table class="table table-hover mb-0" id="jobs-table" style="margin-bottom: 0; background: transparent;">
                            <thead class="table-header-sticky" style="position: sticky; top: 0; z-index: 10; background: var(--theme-secondary); border-bottom: 2px solid var(--theme-border);">
                                <tr>
                                    <th style="width: 200px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Name</th>
                                    <th style="width: 120px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Status</th>
                                    <th style="width: 140px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Progress</th>
                                    <th style="width: 100px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Total Jobs</th>
                                    <th style="width: 100px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Pending</th>
                                    <th style="width: 100px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Failed</th>
                                    <th style="width: 180px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Created</th>
                                    <th style="width: 180px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Finished</th>
                                    <th style="width: 100px; padding: 12px 16px; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--theme-text-secondary);">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="jobs-tbody" style="background: transparent;">
                                <tr ng-if="jobsCtrl.loading" class="jobs-loading-state">
                                    <td colspan="9" class="text-center">
                                        <div class="spinner-border spinner-border-sm me-2" role="status" style="border-color: var(--theme-accent-cyan); border-right-color: transparent;"></div>
                                        Loading jobs...
                                    </td>
                                </tr>
                                <tr ng-if="!jobsCtrl.loading && (!jobsCtrl.jobBatches || jobsCtrl.jobBatches.length === 0)" class="jobs-empty-state">
                                    <td colspan="9">
                                        <i class="bi bi-inbox me-2" style="font-size: 18px; opacity: 0.6;"></i>No job batches found
                                    </td>
                                </tr>
                                <tr ng-repeat="job in jobsCtrl.jobBatches track by job.uuid" 
                                    class="job-row"
                                    ng-style="{'background': $even ? 'var(--theme-secondary)' : 'var(--theme-primary)'}">
                                    <td style="font-size: 13px; color: #FFFFFF; font-weight: 500;">{{ job.name }}</td>
                                    <td>
                                        <span class="job-status-badge" 
                                              ng-class="jobsCtrl.getJobStatusClass(job)"
                                              style="color: #fff;">
                                            {{ jobsCtrl.getJobStatus(job) }}
                                        </span>
                                        <span ng-if="job.failedJobs > 0" 
                                              class="job-status-badge bg-danger ms-1"
                                              style="color: #fff;">
                                            Has Failures
                                        </span>
                                    </td>
                                    <td>
                                        <div class="job-progress">
                                            <div class="job-progress-bar" style="width: {{ jobsCtrl.getProgress(job) }}%;">
                                                {{ jobsCtrl.getProgress(job) }}%
                                            </div>
                                        </div>
                                    </td>
                                    <td style="font-size: 13px; color: #FFFFFF;">{{ job.totalJobs }}</td>
                                    <td style="font-size: 13px; color: #FFFFFF;">{{ job.pendingJobs }}</td>
                                    <td>
                                        <span ng-if="job.failedJobs > 0" style="color: #dc3545; font-size: 13px; font-weight: 600;">{{ job.failedJobs }}</span>
                                        <span ng-if="job.failedJobs === 0" style="color: #FFFFFF; font-size: 13px;">{{ job.failedJobs }}</span>
                                    </td>
                                    <td style="font-size: 12px; color: #B0B0B0;">{{ jobsCtrl.formatDate(job.createdAt) }}</td>
                                    <td style="font-size: 12px; color: #B0B0B0;">
                                        <span ng-if="job.finishedAt">{{ jobsCtrl.formatDate(job.finishedAt) }}</span>
                                        <span ng-if="job.cancelledAt">{{ jobsCtrl.formatDate(job.cancelledAt) }}</span>
                                        <span ng-if="!job.finishedAt && !job.cancelledAt" style="color: #B0B0B0;">-</span>
                                    </td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-primary" 
                                                ng-click="jobsCtrl.viewJobDetails(job.uuid)"
                                                style="border-color: var(--theme-accent-cyan); color: var(--theme-accent-cyan);">
                                            Details
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <div class="card-footer" ng-if="jobsCtrl.pagination && jobsCtrl.pagination.totalPages > 1" style="background: transparent; border-top: 1px solid var(--theme-border); padding: 16px 24px;">
                        <nav aria-label="Jobs pagination">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item" ng-if="jobsCtrl.pagination.currentPage > 1">
                                    <a class="page-link" href="javascript:void(0)" ng-click="jobsCtrl.goToPage(jobsCtrl.pagination.currentPage - 1)" style="background: var(--theme-primary); border-color: var(--theme-border); color: var(--theme-text-primary); cursor: pointer;">Previous</a>
                                </li>
                                
                                <li class="page-item" ng-repeat="i in jobsCtrl.getPaginationPages() track by $index">
                                    <span ng-if="i === '...'" class="page-link" style="background: var(--theme-primary); border-color: var(--theme-border); color: var(--theme-text-secondary);">...</span>
                                    <span ng-if="i !== '...' && i === jobsCtrl.pagination.currentPage" class="page-link" style="background: var(--theme-accent-cyan); border-color: var(--theme-accent-cyan); color: var(--theme-primary);">{{ i }}</span>
                                    <a ng-if="i !== '...' && i !== jobsCtrl.pagination.currentPage" 
                                       class="page-link" 
                                       href="javascript:void(0)" 
                                       ng-click="jobsCtrl.goToPage(i)" 
                                       style="background: var(--theme-primary); border-color: var(--theme-border); color: var(--theme-text-primary); cursor: pointer;">{{ i }}</a>
                                </li>
                                
                                <li class="page-item" ng-if="jobsCtrl.pagination.currentPage < jobsCtrl.pagination.totalPages">
                                    <a class="page-link" href="javascript:void(0)" ng-click="jobsCtrl.goToPage(jobsCtrl.pagination.currentPage + 1)" style="background: var(--theme-primary); border-color: var(--theme-border); color: var(--theme-text-primary); cursor: pointer;">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Job Details Modal -->
<div class="modal fade" id="jobDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: var(--theme-secondary); border: 1px solid var(--theme-border);">
            <div class="modal-header" style="border-bottom: 1px solid var(--theme-border);">
                <h5 class="modal-title text-theme-primary">Job Batch Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
            </div>
            <div class="modal-body" id="jobDetailsContent" style="color: var(--theme-text-primary);">
                <div class="text-center">
                    <div class="spinner-border" role="status" style="border-color: var(--theme-accent-cyan); border-right-color: transparent;">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript" src="/scripts/app/jobs.client.controller.js"></script>
