<h2 class="auth-title">Welcome Back</h2>
<p class="auth-subtitle">Sign in to your account to continue</p>

<% 
// Display flash messages
var messages = typeof messages !== 'undefined' ? messages : {};
var hasError = (typeof error !== 'undefined' && error) || (messages.error && messages.error.length > 0);
var hasSuccess = (typeof success !== 'undefined' && success) || (messages.success && messages.success.length > 0);
%>

<% if (hasError) { %>
<div class="alert alert-danger" role="alert">
    <%= typeof error !== 'undefined' ? error : (messages.error && messages.error[0]) %>
</div>
<% } %>

<% if (hasSuccess) { %>
<div class="alert alert-success" role="alert">
    <%= typeof success !== 'undefined' ? success : (messages.success && messages.success[0]) %>
</div>
<% } %>

<form action="/auth/login" method="POST" novalidate>
    <div class="mb-3">
        <div class="form-floating">
            <input type="email" 
                   class="form-control" 
                   id="email" 
                   name="email" 
                   placeholder="Email address"
                   required>
            <label for="email">Email address</label>
        </div>
    </div>

    <div class="mb-3">
        <div class="form-floating password-input-wrapper">
            <input type="password" 
                   class="form-control" 
                   id="password" 
                   name="password" 
                   placeholder="Password"
                   required>
            <label for="password">Password</label>
            <button type="button" 
                    class="password-toggle" 
                    data-toggle-password="password"
                    aria-label="Toggle password visibility">
                <i class="bi bi-eye" id="password-toggle-icon"></i>
            </button>
        </div>
    </div>

    <div class="mb-3 d-flex justify-content-between align-items-center">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="remember" name="remember">
            <label class="form-check-label" for="remember">
                Remember me
            </label>
        </div>
        <a href="/auth/forgot-password" class="text-accent-cyan text-decoration-none">Forgot password?</a>
    </div>

    <div class="d-grid gap-2">
        <button type="submit" class="btn btn-accent-cyan btn-lg">
            Sign In
        </button>
    </div>

    <div class="auth-footer mt-4">
        <p>Don't have an account? <a href="/auth/register">Sign up</a></p>
    </div>
</form>


