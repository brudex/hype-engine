<div  ng-controller="ProjectManageController as projectCtrl" ng-init="projectCtrl.init('<%= project.uuid %>')">
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h4 class="m-b-5 text-theme-primary">Configure social Accounts</h4>
                    <p class="text-theme-secondary mb-0" ng-if="projectCtrl.project">{{ projectCtrl.project.name }}<span ng-if="projectCtrl.project && projectCtrl.project.description"> — {{ projectCtrl.project.description }}</span></p>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item"><a href="/dashboard/projects">Projects</a></li>
                    <li class="breadcrumb-item active" ng-if="projectCtrl.project">{{ projectCtrl.project.name }}</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="project-service-definitions"><%- JSON.stringify(typeof serviceDefinitions !== 'undefined' ? serviceDefinitions : {}) %></script>
<style>
/* Vertical platform tabs: dark hover, white text, lightened gray background */
.list-group-platform-tabs .list-group-item-action {
    color: rgba(255, 255, 255, 0.9);
}
.list-group-platform-tabs .list-group-item-action:hover {
    background-color: rgba(255, 255, 255, 0.12);
    color: #fff;
    border-color: rgba(255, 255, 255, 0.1);
}
.list-group-platform-tabs .list-group-item-action:focus {
    background-color: rgba(255, 255, 255, 0.08);
    color: #fff;
}
.list-group-platform-tabs .list-group-item-action.active {
    background-color: rgba(15, 77, 93, 0.5);
    color: #fff;
    border-color: rgba(18, 98, 133, 0.15);
}
</style>
<div class="main-body">
    <div class="page-wrapper">
        <div ng-if="projectCtrl.loading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <div ng-if="!projectCtrl.loading && projectCtrl.project">
            <!-- Back Button -->
            <div class="row mb-3">
                <div class="col-md-12 d-flex justify-content-end">
                    <a href="/dashboard/projects" class="btn btn-outline-cyan">
                        <i class="bi bi-arrow-left"></i> Back to Projects
                    </a>
                </div>
            </div>

            <!-- Project Header -->
            <div class="row mb-4">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-body">
                            <div class="d-flex align-items-center">
                                <!-- Circular Image/Initials -->
                                <div class="flex-shrink-0 me-4">
                                    <div ng-if="projectCtrl.project.imageUrl" class="project-image-circle">
                                        <img ng-src="{{ projectCtrl.project.imageUrl }}" alt="{{ projectCtrl.project.name }}" class="project-circle-img">
                                    </div>
                                    <div ng-if="!projectCtrl.project.imageUrl" class="project-initials-circle-large">
                                        {{ projectCtrl.getProjectInitials(projectCtrl.project.name) }}
                                    </div>
                                </div>
                                
                                <!-- Project Info -->
                                <div class="flex-grow-1">
                                    <h4 class="mb-2 text-theme-primary">{{ projectCtrl.project.name }}</h4>
                                    <p class="text-muted mb-3" ng-if="projectCtrl.project.description">{{ projectCtrl.project.description }}</p>
                                    <div class="d-flex gap-4">
                                        <div>
                                            <span class="text-theme-secondary">Accounts:</span>
                                            <strong class="text-theme-primary ms-2">{{ projectCtrl.project.accounts ? projectCtrl.project.accounts.length : 0 }}</strong>
                                        </div>
                                        <div>
                                            <span class="text-theme-secondary">Posts:</span>
                                            <strong class="text-theme-primary ms-2">{{ projectCtrl.project.posts ? projectCtrl.project.posts.length : 0 }}</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Vertical platform tabs: each button has its own tab content -->
            <div class="row">
                <div class="col-md-3">
                    <div class="list-group list-group-platform-tabs" id="platformVerticalTabs" role="tablist">
                        <button class="list-group-item list-group-item-action py-3 active" id="tab-facebook" data-bs-toggle="tab" data-bs-target="#platform-facebook" type="button" role="tab" ng-click="projectCtrl.activePlatform = 'facebook'">
                            <i class="bi bi-facebook text-primary"></i> Facebook
                        </button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-linkedin" data-bs-toggle="tab" data-bs-target="#platform-linkedin" type="button" role="tab" ng-click="projectCtrl.activePlatform = 'linkedin'">
                            <i class="bi bi-linkedin text-primary"></i> LinkedIn
                        </button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-twitter" data-bs-toggle="tab" data-bs-target="#platform-twitter" type="button" role="tab" ng-click="projectCtrl.activePlatform = 'twitter'">
                            <i class="bi bi-twitter text-primary"></i> Twitter
                        </button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-instagram" data-bs-toggle="tab" data-bs-target="#platform-instagram" type="button" role="tab" ng-click="projectCtrl.activePlatform = 'instagram'">
                            <i class="bi bi-instagram text-danger"></i> Instagram
                        </button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-tiktok" data-bs-toggle="tab" data-bs-target="#platform-tiktok" type="button" role="tab" ng-click="projectCtrl.activePlatform = 'tiktok'">
                            <i class="bi bi-tiktok"></i> TikTok
                        </button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-mastodon" data-bs-toggle="tab" data-bs-target="#platform-mastodon" type="button" role="tab" ng-click="projectCtrl.activePlatform = 'mastodon'">
                            <i class="bi bi-mastodon text-primary"></i> Mastodon
                        </button>
                    </div>
                </div>

                <div class="col-md-9 tab-content" id="platformVerticalTabContent">
                    <!-- Facebook tab content -->
                    <div class="tab-pane fade show active" id="platform-facebook" role="tabpanel">
                        <div class="card">
                            <div class="card-body">
                                <div class="btn-group mb-3" role="tablist">
                                    <button type="button" id="tab-facebook-oauth" class="btn btn-outline-primary active" data-bs-toggle="tab" data-bs-target="#facebook-oauth" role="tab" aria-controls="facebook-oauth" aria-selected="true"><i class="bi bi-link-45deg"></i> Connect via OAuth</button>
                                    <button type="button" id="tab-facebook-apikeys" class="btn btn-outline-primary" data-bs-toggle="tab" data-bs-target="#facebook-apikeys" role="tab" aria-controls="facebook-apikeys" aria-selected="false"><i class="bi bi-key"></i> Connect with API keys</button>
                                </div>
                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="facebook-oauth" role="tabpanel" aria-labelledby="tab-facebook-oauth">
                                        <h5 class="card-title"><i class="bi bi-facebook text-primary"></i> Facebook</h5>
                                        <p class="text-theme-secondary">Connect your Facebook Pages to this project.</p>
                                        <div ng-if="projectCtrl.getPlatformAccounts('facebook').length > 0">
                                            <div class="list-group mb-3">
                                                <div class="list-group-item" ng-repeat="account in projectCtrl.getPlatformAccounts('facebook')">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div><h6 class="mb-0">{{ account.name }}</h6><small class="text-muted">{{ account.username }}</small></div>
                                                        <span class="badge" ng-class="account.authorized ? 'bg-success' : 'bg-warning'">{{ account.authorized ? 'Authorized' : 'Unauthorized' }}</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <button class="btn btn-primary" ng-click="projectCtrl.connectAccount('facebook')"><i class="bi bi-plus-circle"></i> Connect Facebook Page</button>
                                    </div>
                                    <div class="tab-pane fade" id="facebook-apikeys" role="tabpanel" aria-labelledby="tab-facebook-apikeys">
                                        <div class="alert alert-info mb-3" role="alert">Authorize connection of your Facebook with API keys.</div>
                                        <form ng-submit="projectCtrl.saveApiKeyConfig('facebook', $event)">
                                            <div class="mb-3" ng-repeat="field in projectCtrl.getFormFields('facebook')">
                                                <label class="form-label">{{ field.fieldLabel }} <span class="text-danger">*</span></label>
                                                <input ng-if="field.fieldType === 'text'" type="text" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <input ng-if="field.fieldType === 'password'" type="password" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <select ng-if="field.fieldType === 'select'" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                    <option value="">Select...</option>
                                                    <option ng-repeat="opt in field.options" value="{{ opt }}">{{ opt }}</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="active" value="true" id="active-facebook" checked>
                                                    <label class="form-check-label" for="active-facebook">Activate this service</label>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-primary" ng-disabled="projectCtrl.savingApiKey && projectCtrl.savingApiKey['facebook']">{{ (projectCtrl.savingApiKey && projectCtrl.savingApiKey['facebook']) ? 'Saving...' : 'Save Configuration' }}</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- LinkedIn tab content -->
                    <div class="tab-pane fade" id="platform-linkedin" role="tabpanel">
                        <div class="card">
