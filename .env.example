# Application
NODE_ENV=development
PORT=3000
SITEURL=http://localhost:3000

# PostgreSQL
DBHOST=localhost
DBNAME=hype_engine
DBUSER=hype_engine
DBPASS=replace-with-a-strong-database-password

# Use a long, randomly generated value and keep it stable.
# Changing JWT_SECRET makes existing encrypted provider credentials unreadable.
JWT_SECRET=replace-with-a-long-random-secret

# Optional legacy/development schema synchronization. Keep false in production.
SEQUELIZE_AUTO_SYNC=false

# Optional workflow integrations
# OPENAI_API_KEY=

# Optional logging
# APP_NAME=hypeengine
# LOG_LEVEL=info
# DB_LOG_LEVEL=info
# DB_LOG_BATCH_SIZE=10
# DB_LOG_BATCH_INTERVAL=5000
