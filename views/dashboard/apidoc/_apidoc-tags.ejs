<!-- List Tags Section -->
<div ng-if="apiDocCtrl.activeSection === 'list-tags'" class="api-doc-section">
    <div class="api-endpoint-header">
        <span class="badge badge-info">GET</span>
        <h2 class="api-doc-title">List Tags</h2>
    </div>
    <p class="api-doc-description">
        Retrieves a list of all tags for a specific project.
    </p>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Endpoint</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>URL</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('list-tags-url')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="list-tags-url">
                <pre><code>GET /api/v1/:projectUuid/tags</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Response</h3>
        <p><strong>Success (200):</strong></p>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Success Response</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('list-tags-success')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="list-tags-success">
                <pre><code>{
  "success": true,
  "data": [
    {
      "uuid": "tag-uuid",
      "name": "Marketing",
      "hex_color": "3B82F6",
      "created_at": "2024-01-15T10:00:00Z"
    }
  ]
}</code></pre>
            </div>
        </div>
    </div>
</div>

