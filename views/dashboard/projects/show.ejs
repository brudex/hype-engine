                                                    <label class="form-check-label" for="active-linkedin">Activate this service</label>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-primary" ng-disabled="projectCtrl.savingApiKey && projectCtrl.savingApiKey['linkedin']">{{ (projectCtrl.savingApiKey && projectCtrl.savingApiKey['linkedin']) ? 'Saving...' : 'Save Configuration' }}</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Twitter tab content -->
