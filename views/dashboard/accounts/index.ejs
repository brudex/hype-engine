<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h4 class="m-b-5 text-theme-primary">Configure social Accounts</h4>
                    <p class="text-theme-secondary mb-0" ng-if="accountsCtrl.selectedProject">Manage social accounts for {{ accountsCtrl.selectedProject.name }}</p>
                    <p class="text-theme-secondary mb-0" ng-if="!accountsCtrl.selectedProject">Select a project to manage social accounts</p>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item"><a href="/dashboard/projects">Projects</a></li>
                    <li class="breadcrumb-item active">Accounts</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="accounts-service-definitions"><%- JSON.stringify(typeof serviceDefinitions !== 'undefined' ? serviceDefinitions : {}) %></script>
<style>
.list-group-platform-tabs .list-group-item-action { color: rgba(255, 255, 255, 0.9); }
.list-group-platform-tabs .list-group-item-action:hover { background-color: rgba(255, 255, 255, 0.12); color: #fff; border-color: rgba(255, 255, 255, 0.1); }
.list-group-platform-tabs .list-group-item-action:focus { background-color: rgba(255, 255, 255, 0.08); color: #fff; }
.list-group-platform-tabs .list-group-item-action.active { background-color: rgba(255, 255, 255, 0.15); color: #fff; border-color: rgba(255, 255, 255, 0.15); }
</style>

<div class="main-body mt-0" ng-controller="AccountsController as accountsCtrl" ng-init='accountsCtrl.init(<%- JSON.stringify(accounts || []) %>, <%- JSON.stringify(is_configured_service || {}) %>, <%- JSON.stringify(is_service_active || {}) %>, <%- JSON.stringify(typeof projectUuid !== "undefined" ? projectUuid : "") %>)'>
    <div class="page-wrapper">
        <!-- Project Selection (keep dropdown only) -->
        <%- include('../partials/_project-selection', { controllerName: 'accountsCtrl', placeholder: '..Select Project..' }) %>

        <div ng-if="accountsCtrl.loading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div>
        </div>

        <div ng-if="!accountsCtrl.loading && !accountsCtrl.selectedProject" class="text-center py-5">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                <h5 class="alert-heading">Select a Project</h5>
                <p class="mb-0">Please select a project from the dropdown above to manage social accounts.</p>
            </div>
        </div>

        <!-- Vertical platform tabs (same UI as project show) -->
        <div ng-if="!accountsCtrl.loading && accountsCtrl.selectedProject">
            <div class="row">
                <div class="col-md-3">
                    <div class="list-group list-group-platform-tabs" id="accountsPlatformTabs" role="tablist">
                        <button class="list-group-item list-group-item-action py-3 active" id="tab-acc-facebook" data-bs-toggle="tab" data-bs-target="#acc-platform-facebook" type="button" role="tab"><i class="bi bi-facebook text-primary"></i> Facebook</button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-acc-linkedin" data-bs-toggle="tab" data-bs-target="#acc-platform-linkedin" type="button" role="tab"><i class="bi bi-linkedin text-primary"></i> LinkedIn</button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-acc-twitter" data-bs-toggle="tab" data-bs-target="#acc-platform-twitter" type="button" role="tab"><i class="bi bi-twitter text-primary"></i> Twitter</button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-acc-instagram" data-bs-toggle="tab" data-bs-target="#acc-platform-instagram" type="button" role="tab"><i class="bi bi-instagram text-danger"></i> Instagram</button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-acc-tiktok" data-bs-toggle="tab" data-bs-target="#acc-platform-tiktok" type="button" role="tab"><i class="bi bi-tiktok"></i> TikTok</button>
                        <button class="list-group-item list-group-item-action py-3" id="tab-acc-mastodon" data-bs-toggle="tab" data-bs-target="#acc-platform-mastodon" type="button" role="tab"><i class="bi bi-mastodon text-primary"></i> Mastodon</button>
                    </div>
                </div>
                <div class="col-md-9 tab-content" id="accountsPlatformTabContent">
                    <!-- Facebook -->
                    <div class="tab-pane fade show active" id="acc-platform-facebook" role="tabpanel">
                        <div class="card">
                            <div class="card-body">
                                <div class="btn-group mb-3" role="tablist">
                                    <button type="button" id="tab-acc-facebook-oauth" class="btn btn-outline-primary active" data-bs-toggle="tab" data-bs-target="#acc-facebook-oauth" role="tab" aria-controls="acc-facebook-oauth" aria-selected="true"><i class="bi bi-link-45deg"></i> Connect via OAuth</button>
                                    <button type="button" id="tab-acc-facebook-apikeys" class="btn btn-outline-primary" data-bs-toggle="tab" data-bs-target="#acc-facebook-apikeys" role="tab" aria-controls="acc-facebook-apikeys" aria-selected="false"><i class="bi bi-key"></i> Connect with API keys</button>
                                </div>
                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="acc-facebook-oauth" role="tabpanel" aria-labelledby="tab-acc-facebook-oauth">
                                        <h5 class="card-title"><i class="bi bi-facebook text-primary"></i> Facebook</h5>
                                        <p class="text-theme-secondary">Connect your Facebook Pages to this project.</p>
                                        <div ng-if="accountsCtrl.getPlatformAccounts('facebook').length > 0">
                                            <div class="list-group mb-3">
                                                <div class="list-group-item d-flex justify-content-between align-items-center" ng-repeat="account in accountsCtrl.getPlatformAccounts('facebook')">
                                                    <div><h6 class="mb-0">{{ account.name }}</h6><small class="text-muted">{{ account.username || 'N/A' }}</small></div>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <span class="badge" ng-class="account.authorized ? 'bg-success' : 'bg-warning'">{{ account.authorized ? 'Authorized' : 'Unauthorized' }}</span>
                                                        <div class="dropdown">
                                                            <button class="btn btn-sm btn-link p-0" type="button" data-bs-toggle="dropdown"><i class="bi bi-three-dots-vertical"></i></button>
                                                            <ul class="dropdown-menu dropdown-menu-end">
                                                                <li><a class="dropdown-item" href="#" ng-click="accountsCtrl.refreshAccount(account.uuid); $event.preventDefault()"><i class="bi bi-arrow-clockwise me-2"></i> Refresh</a></li>
                                                                <li><a class="dropdown-item text-danger" href="#" ng-click="accountsCtrl.deleteAccount(account.uuid); $event.preventDefault()"><i class="bi bi-trash me-2"></i> Delete</a></li>
                                                            </ul>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <button class="btn btn-primary" ng-click="accountsCtrl.connectAccount('facebook')"><i class="bi bi-plus-circle"></i> Connect Facebook Page</button>
                                    </div>
                                    <div class="tab-pane fade" id="acc-facebook-apikeys" role="tabpanel" aria-labelledby="tab-acc-facebook-apikeys">
                                        <div class="alert alert-info mb-3" role="alert">Authorize connection of your Facebook with API keys.</div>
                                        <form ng-submit="accountsCtrl.saveApiKeyConfig('facebook', $event)">
                                            <div class="mb-3" ng-repeat="field in accountsCtrl.getFormFields('facebook')">
                                                <label class="form-label">{{ field.fieldLabel }} <span class="text-danger">*</span></label>
                                                <input ng-if="field.fieldType === 'text'" type="text" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <input ng-if="field.fieldType === 'password'" type="password" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <select ng-if="field.fieldType === 'select'" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                    <option value="">Select...</option>
                                                    <option ng-repeat="opt in field.options" value="{{ opt }}">{{ opt }}</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="active" value="true" id="acc-active-facebook" checked>
                                                    <label class="form-check-label" for="acc-active-facebook">Activate this service</label>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-primary" ng-disabled="accountsCtrl.savingApiKey && accountsCtrl.savingApiKey['facebook']">{{ (accountsCtrl.savingApiKey && accountsCtrl.savingApiKey['facebook']) ? 'Saving...' : 'Save Configuration' }}</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
