<!-- List Media Section -->
<div ng-if="apiDocCtrl.activeSection === 'list-media'" class="api-doc-section">
    <div class="api-endpoint-header">
        <span class="badge badge-info">GET</span>
        <h2 class="api-doc-title">List Media</h2>
    </div>
    <p class="api-doc-description">
        Retrieves a paginated list of media files in your library.
    </p>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Endpoint</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>URL</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('list-media-url')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="list-media-url">
                <pre><code>GET /api/v1/media?page={page}&limit={limit}</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Query Parameters</h3>
        <ul class="api-doc-list">
            <li><code>page</code> (optional) - Page number (default: 1)</li>
            <li><code>limit</code> (optional) - Items per page (default: 20, max: 100)</li>
        </ul>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Response</h3>
        <p><strong>Success (200):</strong></p>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Success Response</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('list-media-success')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="list-media-success">
                <pre><code>{
  "success": true,
  "data": [
    {
      "uuid": "media-uuid",
      "name": "image.jpg",
      "mime_type": "image/jpeg",
      "url": "/uploads/...",
      "thumb_url": "/uploads/...",
      "size": 1024000,
      "created_at": "2024-01-15T10:00:00Z"
    }
  ],
  "meta": {
    "total": 150,
    "page": 1,
    "per_page": 20,
    "last_page": 8
  }
}</code></pre>
            </div>
        </div>
    </div>
</div>

<!-- Get Media Section -->
<div ng-if="apiDocCtrl.activeSection === 'get-media'" class="api-doc-section">
    <div class="api-endpoint-header">
        <span class="badge badge-info">GET</span>
