                        <div class="card">
                            <div class="card-body">
                                <div class="btn-group mb-3" role="tablist">
                                    <button type="button" id="tab-mastodon-oauth" class="btn btn-outline-primary active" data-bs-toggle="tab" data-bs-target="#mastodon-oauth" role="tab" aria-controls="mastodon-oauth" aria-selected="true"><i class="bi bi-link-45deg"></i> Connect via OAuth</button>
                                    <button type="button" id="tab-mastodon-apikeys" class="btn btn-outline-primary" data-bs-toggle="tab" data-bs-target="#mastodon-apikeys" role="tab" aria-controls="mastodon-apikeys" aria-selected="false"><i class="bi bi-key"></i> Connect with API keys</button>
                                </div>
                                <div class="tab-content">
                                    <div class="tab-pane fade show active" id="mastodon-oauth" role="tabpanel" aria-labelledby="tab-mastodon-oauth">
                                        <h5 class="card-title"><i class="bi bi-mastodon text-primary"></i> Mastodon</h5>
                                        <p class="text-theme-secondary">Connect your Mastodon accounts to this project.</p>
                                        <div ng-if="projectCtrl.getPlatformAccounts('mastodon').length > 0">
                                            <div class="list-group mb-3">
                                                <div class="list-group-item" ng-repeat="account in projectCtrl.getPlatformAccounts('mastodon')">
                                                    <div class="d-flex justify-content-between align-items-center">
                                                        <div><h6 class="mb-0">{{ account.name }}</h6><small class="text-muted">{{ account.username }}</small></div>
                                                        <span class="badge" ng-class="account.authorized ? 'bg-success' : 'bg-warning'">{{ account.authorized ? 'Authorized' : 'Unauthorized' }}</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        <button class="btn btn-primary" ng-click="projectCtrl.connectAccount('mastodon')"><i class="bi bi-plus-circle"></i> Connect Mastodon Account</button>
                                    </div>
                                    <div class="tab-pane fade" id="mastodon-apikeys" role="tabpanel" aria-labelledby="tab-mastodon-apikeys">
                                        <div class="alert alert-info mb-3" role="alert">Authorize connection of your Mastodon with API keys.</div>
                                        <form ng-submit="projectCtrl.saveApiKeyConfig('mastodon', $event)">
                                            <div class="mb-3" ng-repeat="field in projectCtrl.getFormFields('mastodon')">
                                                <label class="form-label">{{ field.fieldLabel }} <span class="text-danger">*</span></label>
                                                <input ng-if="field.fieldType === 'text'" type="text" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <input ng-if="field.fieldType === 'password'" type="password" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                <select ng-if="field.fieldType === 'select'" class="form-control" name="configuration[{{ field.fieldName }}]" required>
                                                    <option value="">Select...</option>
                                                    <option ng-repeat="opt in field.options" value="{{ opt }}">{{ opt }}</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="active" value="true" id="active-mastodon" checked>
                                                    <label class="form-check-label" for="active-mastodon">Activate this service</label>
                                                </div>
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button type="submit" class="btn btn-primary" ng-disabled="projectCtrl.savingApiKey && projectCtrl.savingApiKey['mastodon']">{{ (projectCtrl.savingApiKey && projectCtrl.savingApiKey['mastodon']) ? 'Saving...' : 'Save Configuration' }}</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</div>
<script src="/scripts/app/project-manage.client.controller.js"></script>
