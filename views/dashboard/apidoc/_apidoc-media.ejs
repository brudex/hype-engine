<!-- Upload Media Section -->
<div ng-if="apiDocCtrl.activeSection === 'upload-media'" class="api-doc-section">
    <div class="api-endpoint-header">
        <span class="badge badge-success">POST</span>
        <h2 class="api-doc-title">Upload Media</h2>
    </div>
    <p class="api-doc-description">
        Uploads a media file (image or video) to your media library. The file can then be attached to posts.
    </p>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Endpoint</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>URL</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('upload-media-url')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="upload-media-url">
                <pre><code>POST /api/v1/media</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Request</h3>
        <p><strong>Body (multipart/form-data):</strong></p>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Form Data</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('upload-media-body')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="upload-media-body">
                <pre><code>file: [File] (required)
name: "string" (optional)</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Response</h3>
        <p><strong>Success (200):</strong></p>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Success Response</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('upload-media-success')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="upload-media-success">
                <pre><code>{
  "success": true,
  "data": {
    "uuid": "media-uuid",
    "name": "image.jpg",
    "mime_type": "image/jpeg",
    "url": "/uploads/...",
    "size": 1024000,
    "created_at": "2024-01-15T10:00:00Z"
  }
}</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Notes</h3>
        <ul class="api-doc-list">
            <li>Supported file types: JPEG, PNG, GIF, MP4, MOV</li>
            <li>Maximum file size: 50MB</li>
            <li>The <code>name</code> field is optional; if not provided, the original filename is used</li>
            <li>Media files are stored securely and accessible via the returned URL</li>
        </ul>
    </div>
    <button class="btn btn-outline-primary mt-3" ng-click="apiDocCtrl.testSidebarCollapsed = false">
        <i class="bi bi-play-circle me-1"></i>Test in Console
    </button>
</div>

<!-- Update Media Section -->
