<!DOCTYPE html>
<html lang="en" data-ng-app="app">

<head>
    <title><%= typeof title !== 'undefined' ? title : 'Mixpost' %> - Social Media Management</title>
    <!-- Meta -->
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui">
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="description" content="Mixpost - Social Media Management Platform">
    <meta name="keywords" content="Mixpost, Social Media, Management, Automation">
    <meta name="author" content="Mixpost">
    <!-- Favicon icon -->
    <link rel="icon" href="/assets/images/favicon.ico" type="image/x-icon">
    <!-- Google font-->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" type="text/css" href="/bootstrap-5.3.8/css/bootstrap.min.css">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <!-- Theme CSS -->
    <link rel="stylesheet" type="text/css" href="/css/theme.css">
    <!-- Auth CSS -->
    <link rel="stylesheet" type="text/css" href="/css/auth.css">
    <%- typeof style !== 'undefined' ? style : '' %>
</head>

<body>
    <div class="auth-container">
        <div class="auth-card">
            <div class="auth-logo">
                <h1>Mixpost</h1>
            </div>
            <%- body %>
        </div>
        <div class="auth-footer">
            <p>&copy; <%= new Date().getFullYear() %> Mixpost. All rights reserved.</p>
        </div>
    </div>

    <!-- Bootstrap 5 JS Bundle -->
    <script src="/bootstrap-5.3.8/js/bootstrap.bundle.min.js"></script>
    <!-- jQuery -->
    <script src="/scripts/jquery-3.6.4.min.js"></script>
    <!-- AngularJS -->
    <script src="/scripts/angular.min.js"></script>
    <script src="/scripts/angular-animate.min.js"></script>
    <!-- App Module -->
    <script src="/scripts/app/app.module.js"></script>
    <!-- Validator -->
    <script src="/scripts/validator.min.js"></script>
    <!-- Auth Client JS -->
    <script src="/js/auth.client.js"></script>
    <%- typeof script !== 'undefined' ? script : '' %>
</body>

</html>
