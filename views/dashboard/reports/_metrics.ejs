<!-- Metrics Table -->
<div class="card" ng-if="reportsCtrl.reportData && reportsCtrl.reportData.metrics.length > 0">
    <div class="card-header">
        <h5>Metrics</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover metrics-table">
                <thead>
                    <tr>
                        <th style="width: 40px;"></th>
                        <th>Date</th>
                        <th>Account</th>
                        <th>Provider</th>
                        <th>Metrics</th>
                    </tr>
                </thead>
                <tbody>
                    <tr ng-repeat-start="metric in reportsCtrl.reportData.metrics track by $index"
                        class="metric-row"
                        ng-class="{'expanded': reportsCtrl.isRowExpanded($index)}">
                        <td>
                            <button type="button" 
                                    class="btn btn-sm btn-link p-0 expand-toggle"
                                    ng-click="reportsCtrl.toggleMetricRow($index)"
                                    ng-if="reportsCtrl.getMetricValue(metric, 'likes') || reportsCtrl.getMetricValue(metric, 'retweets') || reportsCtrl.getMetricValue(metric, 'replies') || reportsCtrl.getMetricValue(metric, 'impressions') || reportsCtrl.getMetricValue(metric, 'reblogs') || reportsCtrl.getMetricValue(metric, 'favourites')">
                                <i class="bi" ng-class="reportsCtrl.isRowExpanded($index) ? 'bi-chevron-down' : 'bi-chevron-right'"></i>
                            </button>
                        </td>
                        <td>
                            <span ng-if="metric.date">{{ metric.date }}</span>
                            <span ng-if="!metric.date" class="text-muted">-</span>
                        </td>
                        <td>
                            <span ng-if="metric.account && metric.account.name">{{ metric.account.name }}</span>
                            <span ng-if="!metric.account || !metric.account.name" class="text-muted">N/A</span>
                        </td>
                        <td>
                            <span class="badge provider-badge" 
                                  ng-class="'provider-' + (metric.account && metric.account.provider ? metric.account.provider : 'unknown')">
                                {{ metric.account && metric.account.provider ? metric.account.provider : 'N/A' }}
                            </span>
                        </td>
                        <td>
                            <div class="metric-badges">
                                <span class="metric-badge" ng-if="reportsCtrl.getMetricValue(metric, 'likes') > 0">
                                    <i class="bi bi-heart-fill"></i>
                                    <span ng-bind="reportsCtrl.getMetricValue(metric, 'likes') | number"></span>
                                </span>
                                <span class="metric-badge" ng-if="reportsCtrl.getMetricValue(metric, 'retweets') > 0">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span ng-bind="reportsCtrl.getMetricValue(metric, 'retweets') | number"></span>
                                </span>
                                <span class="metric-badge" ng-if="reportsCtrl.getMetricValue(metric, 'reblogs') > 0">
                                    <i class="bi bi-arrow-repeat"></i>
                                    <span ng-bind="reportsCtrl.getMetricValue(metric, 'reblogs') | number"></span>
                                </span>
                                <span class="metric-badge" ng-if="reportsCtrl.getMetricValue(metric, 'replies') > 0">
                                    <i class="bi bi-chat-dots-fill"></i>
                                    <span ng-bind="reportsCtrl.getMetricValue(metric, 'replies') | number"></span>
                                </span>
                                <span class="metric-badge" ng-if="reportsCtrl.getMetricValue(metric, 'favourites') > 0">
                                    <i class="bi bi-star-fill"></i>
                                    <span ng-bind="reportsCtrl.getMetricValue(metric, 'favourites') | number"></span>
                                </span>
                                <span class="metric-badge" ng-if="reportsCtrl.getMetricValue(metric, 'impressions') > 0">
                                    <i class="bi bi-eye-fill"></i>
                                    <span ng-bind="reportsCtrl.getMetricValue(metric, 'impressions') | number"></span>
                                </span>
                            </div>
                        </td>
                    </tr>
                    <tr ng-if="reportsCtrl.isRowExpanded($index)" 
                        class="metric-detail-row"
                        ng-repeat-end>
                        <td colspan="5">
                            <div class="metric-details">
                                <div class="row g-3">
                                    <div class="col-md-3" ng-if="reportsCtrl.getMetricValue(metric, 'likes') > 0">
                                        <div class="metric-detail-item">
                                            <i class="bi bi-heart-fill text-danger"></i>
                                            <div>
                                                <strong>Likes</strong>
                                                <div class="metric-value" ng-bind="reportsCtrl.getMetricValue(metric, 'likes') | number"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3" ng-if="reportsCtrl.getMetricValue(metric, 'retweets') > 0">
                                        <div class="metric-detail-item">
                                            <i class="bi bi-arrow-repeat text-primary"></i>
                                            <div>
                                                <strong>Retweets</strong>
                                                <div class="metric-value" ng-bind="reportsCtrl.getMetricValue(metric, 'retweets') | number"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3" ng-if="reportsCtrl.getMetricValue(metric, 'reblogs') > 0">
                                        <div class="metric-detail-item">
                                            <i class="bi bi-arrow-repeat text-info"></i>
                                            <div>
                                                <strong>Reblogs</strong>
                                                <div class="metric-value" ng-bind="reportsCtrl.getMetricValue(metric, 'reblogs') | number"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3" ng-if="reportsCtrl.getMetricValue(metric, 'replies') > 0">
                                        <div class="metric-detail-item">
                                            <i class="bi bi-chat-dots-fill text-success"></i>
                                            <div>
                                                <strong>Replies</strong>
                                                <div class="metric-value" ng-bind="reportsCtrl.getMetricValue(metric, 'replies') | number"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3" ng-if="reportsCtrl.getMetricValue(metric, 'favourites') > 0">
                                        <div class="metric-detail-item">
                                            <i class="bi bi-star-fill text-warning"></i>
                                            <div>
                                                <strong>Favourites</strong>
                                                <div class="metric-value" ng-bind="reportsCtrl.getMetricValue(metric, 'favourites') | number"></div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3" ng-if="reportsCtrl.getMetricValue(metric, 'impressions') > 0">
                                        <div class="metric-detail-item">
                                            <i class="bi bi-eye-fill text-info"></i>
                                            <div>
                                                <strong>Impressions</strong>
                                                <div class="metric-value" ng-bind="reportsCtrl.getMetricValue(metric, 'impressions') | number"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Empty State for Metrics -->
<div ng-if="reportsCtrl.reportData && reportsCtrl.reportData.metrics.length === 0" class="text-center py-5">
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        <h5 class="alert-heading">No Metrics Data</h5>
        <p class="mb-0">No metrics data found for the selected period. Try adjusting the date range.</p>
    </div>
</div>

