<div class="page-header mb-0">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h4 class="m-b-5 text-theme-primary">API Keys</h4>
                    <p class="text-theme-secondary mb-0">Manage your API keys for programmatic access</p>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item"><a href="/dashboard/apidoc">API Documentation</a></li>
                    <li class="breadcrumb-item active">API Keys</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="main-body mt-0" ng-controller="ApiKeysController as keysCtrl" ng-init="keysCtrl.init()">
    <div class="page-wrapper">
        <!-- Header with Create Button -->
        <div class="row mb-3">
            <div class="col-md-12">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-theme-secondary mb-0">Create and manage API keys to access the Mixpost API programmatically</p>
                    </div>
                    <div>
                        <button class="btn posts-create-btn" ng-click="keysCtrl.openCreateModal()">
                            <i class="bi bi-plus-circle"></i> Create API Key
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- API Keys Table -->
        <div class="row">
            <div class="col-md-12">
                <div class="card posts-table-card">
                    <div class="card-body p-0 posts-table-card-body">
                        <!-- Loading State -->
                        <div ng-if="keysCtrl.loading" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>

                        <!-- Empty State -->
                        <div ng-if="!keysCtrl.loading && keysCtrl.apiKeys.length === 0" class="text-center posts-empty-state">
                            <i class="bi bi-key posts-empty-icon"></i>
                            <h5 class="text-theme-primary mb-2">No API keys yet</h5>
                            <p class="text-theme-secondary mb-4">Create your first API key to start using the Mixpost API</p>
                            <button class="btn posts-create-btn" ng-click="keysCtrl.openCreateModal()">
                                <i class="bi bi-plus-circle me-2"></i>Create Your First API Key
                            </button>
                        </div>

                        <!-- API Keys Table -->
                        <div ng-if="!keysCtrl.loading && keysCtrl.apiKeys.length > 0" class="table-responsive">
                            <table class="table table-hover mb-0 posts-table">
                                <thead>
                                    <tr>
                                        <th style="width: 400px;">Name</th>
                                        <th style="width: 200px;">Key</th>
                                        <th style="width: 150px;">Status</th>
                                        <th style="width: 180px;">Last Used</th>
                                        <th style="width: 100px;"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr ng-repeat="key in keysCtrl.apiKeys" 
                                        class="posts-table-row">
                                        <td class="posts-table-cell">
                                            <div>
                                                <h6 class="mb-1 text-theme-primary" style="font-size: 14px; font-weight: 600;">{{ key.name }}</h6>
                                                <p class="mb-0 text-theme-secondary small" ng-if="key.description" style="font-size: 12px;">
                                                    {{ key.description }}
                                                </p>
                                            </div>
                                        </td>
                                        <td class="posts-table-cell">
                                            <code class="api-key-code">{{ key.key }}</code>
                                        </td>
                                        <td class="posts-table-cell">
                                            <span class="badge badge-success" 
                                                  ng-if="key.lastUsedAt">
                                                <i class="bi bi-check-circle"></i>Active
                                            </span>
                                            <span class="badge badge-secondary" 
                                                  ng-if="!key.lastUsedAt">
                                                <i class="bi bi-circle"></i>Never Used
                                            </span>
                                        </td>
                                        <td class="posts-table-cell">
                                            <div class="text-theme-secondary small">
                                                <span ng-if="key.lastUsedAt">
                                                    <i class="bi bi-clock me-1"></i>{{ keysCtrl.formatDate(key.lastUsedAt) }}
                                                </span>
                                                <span ng-if="!key.lastUsedAt" class="text-muted">
                                                    <i class="bi bi-calendar me-1"></i>{{ keysCtrl.formatDate(key.createdAt) }}
                                                </span>
                                            </div>
                                        </td>
                                        <td ng-click="$event.stopPropagation()" class="posts-table-cell">
                                            <div class="d-flex align-items-center gap-2">
                                                <button class="btn btn-sm btn-link" 
                                                        ng-click="keysCtrl.viewKeyDetails(key)"
                                                        title="View Details">
                                                    <i class="bi bi-eye" style="font-size: 16px; color: #00EFFF;"></i>
                                                </button>
                                                <button class="btn btn-sm btn-link" 
                                                        ng-click="keysCtrl.deleteApiKey(key)"
                                                        title="Delete">
                                                    <i class="bi bi-trash" style="font-size: 16px; color: #FF6B6B;"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Create API Key Modal -->
    <div class="modal fade" id="createApiKeyModal" tabindex="-1" aria-labelledby="createApiKeyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="createApiKeyModalLabel">Create API Key</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="createApiKeyForm">
                        <div class="mb-3">
                            <label for="apiKeyName" class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" 
                                   class="form-control" 
                                   id="apiKeyName" 
                                   ng-model="keysCtrl.newKey.name" 
                                   placeholder="e.g., Production API Key"
                                   required>
                            <small class="form-text text-muted">Give your API key a descriptive name</small>
                        </div>

                        <div class="mb-3">
                            <label for="apiKeyDescription" class="form-label">Description</label>
                            <textarea class="form-control" 
                                      id="apiKeyDescription" 
                                      ng-model="keysCtrl.newKey.description" 
                                      rows="3"
                                      placeholder="Optional description for this API key"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Scopes <span class="text-danger">*</span></label>
                            <div class="card" style="background: rgba(31, 31, 35, 0.6); border: 1px solid rgba(255, 255, 255, 0.1);">
                                <div class="card-body">
                                    <div class="form-check mb-3">
                                        <input class="form-check-input" 
                                               type="radio" 
                                               name="scopeType" 
                                               id="scopeAllProjects"
                                               ng-model="keysCtrl.newKey.scopeType"
                                               value="all"
                                               ng-change="keysCtrl.onScopeTypeChange()">
                                        <label class="form-check-label" for="scopeAllProjects">
                                            <strong class="text-theme-primary">All Projects</strong>
                                            <p class="mb-0 text-theme-secondary small">This API key will have access to all your projects</p>
                                        </label>
                                    </div>

                                    <div class="form-check">
                                        <input class="form-check-input" 
                                               type="radio" 
                                               name="scopeType" 
                                               id="scopeSelectedProjects"
                                               ng-model="keysCtrl.newKey.scopeType"
                                               value="selected"
                                               ng-change="keysCtrl.onScopeTypeChange()">
                                        <label class="form-check-label" for="scopeSelectedProjects">
                                            <strong class="text-theme-primary">Selected Projects</strong>
                                            <p class="mb-0 text-theme-secondary small">Choose specific projects this API key can access</p>
                                        </label>
                                    </div>

                                    <!-- Project Selection (shown when "Selected Projects" is chosen) -->
                                    <div ng-if="keysCtrl.newKey.scopeType === 'selected'" class="mt-3 pt-3 border-top" style="border-color: rgba(255, 255, 255, 0.1) !important;">
                                        <label class="form-label mb-2">Select Projects:</label>
                                        <div ng-if="keysCtrl.loadingProjects" class="text-center py-2">
                                            <div class="spinner-border spinner-border-sm text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </div>
                                        <div ng-if="!keysCtrl.loadingProjects && keysCtrl.projects.length === 0" class="text-center py-2">
                                            <p class="text-theme-secondary small mb-0">No projects available</p>
                                        </div>
                                        <div ng-if="!keysCtrl.loadingProjects && keysCtrl.projects.length > 0">
                                            <multi-select 
                                                ng-model="keysCtrl.newKey.selectedProjects"
                                                options="keysCtrl.projects"
                                                option-value="uuid"
                                                option-label="name"
                                                placeholder="Select projects..."
                                                search-enabled="true"
                                                remove-item-button="true"
                                                on-select="keysCtrl.onProjectsSelected()">
                                            </multi-select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-primary" ng-click="keysCtrl.createApiKey()" ng-disabled="!keysCtrl.canCreateKey() || keysCtrl.creating">
                        <span ng-if="!keysCtrl.creating">
                            <i class="bi bi-check-circle me-1"></i>Create API Key
                        </span>
                        <span ng-if="keysCtrl.creating">
                            <span class="spinner-border spinner-border-sm me-1"></span>Creating...
                        </span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- View API Key Details Modal -->
    <div class="modal fade" id="viewApiKeyModal" tabindex="-1" aria-labelledby="viewApiKeyModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="viewApiKeyModalLabel">API Key Details</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <!-- Loading State -->
                    <div ng-if="keysCtrl.loadingKeyDetails" class="text-center py-4">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>

                    <!-- Key Details -->
                    <div ng-if="!keysCtrl.loadingKeyDetails && keysCtrl.viewingKey">
                        <div class="mb-3">
                            <label class="form-label">Name:</label>
                            <p class="text-theme-primary mb-0">{{ keysCtrl.viewingKey.name }}</p>
                        </div>

                    <div class="mb-3" ng-if="keysCtrl.viewingKey.description">
                        <label class="form-label">Description:</label>
                        <p class="text-theme-secondary mb-0">{{ keysCtrl.viewingKey.description }}</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">API Key:</label>
                        <div class="d-flex align-items-center">
                            <code class="api-key-code-display flex-grow-1" style="word-break: break-all;">{{ keysCtrl.viewingKey.fullKey || keysCtrl.viewingKey.key }}</code>
                            <button class="btn btn-sm btn-primary ms-2" ng-click="keysCtrl.copyToClipboard(keysCtrl.viewingKey.fullKey || keysCtrl.viewingKey.key)">
                                <i class="bi bi-clipboard me-1"></i>Copy
                            </button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Scopes:</label>
                        <div>
                            <span class="badge badge-info me-2" 
                                  ng-if="keysCtrl.viewingKey.scopes && keysCtrl.viewingKey.scopes.allProjects === true">
                                <i class="bi bi-globe"></i>All Projects
                            </span>
                        </div>
                        <div ng-if="keysCtrl.viewingKey.scopes && keysCtrl.viewingKey.scopes.allProjects === false && keysCtrl.viewingKey.scopes.projectDetails && keysCtrl.viewingKey.scopes.projectDetails.length > 0" class="mt-2">
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge badge-success" 
                                      ng-repeat="project in keysCtrl.viewingKey.scopes.projectDetails">
                                    <i class="bi bi-folder"></i>{{ project.name }}
                                </span>
                            </div>
                        </div>
                        <div ng-if="keysCtrl.viewingKey.scopes && keysCtrl.viewingKey.scopes.allProjects === false && (!keysCtrl.viewingKey.scopes.projectDetails || keysCtrl.viewingKey.scopes.projectDetails.length === 0) && keysCtrl.viewingKey.scopes.projects && keysCtrl.viewingKey.scopes.projects.length > 0" class="mt-2">
                            <div class="d-flex flex-wrap gap-2">
                                <span class="badge badge-success" 
                                      ng-repeat="projectUuid in keysCtrl.viewingKey.scopes.projects">
                                    <i class="bi bi-folder"></i>{{ projectUuid }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Status:</label>
                        <div>
                            <span class="badge posts-status-badge" 
                                  ng-if="keysCtrl.viewingKey.lastUsedAt"
                                  style="background-color: rgba(40, 167, 69, 0.2); color: #28a745; border: 1px solid rgba(40, 167, 69, 0.3);">
                                <i class="bi bi-check-circle me-1"></i>Active
                            </span>
                            <span class="badge posts-status-badge" 
                                  ng-if="!keysCtrl.viewingKey.lastUsedAt"
                                  style="background-color: rgba(108, 117, 125, 0.2); color: #6c757d; border: 1px solid rgba(108, 117, 125, 0.3);">
                                <i class="bi bi-circle me-1"></i>Never Used
                            </span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Created:</label>
                        <p class="text-theme-secondary mb-0">{{ keysCtrl.formatDate(keysCtrl.viewingKey.createdAt) }}</p>
                    </div>

                    <div class="mb-3" ng-if="keysCtrl.viewingKey.lastUsedAt">
                        <label class="form-label">Last Used:</label>
                        <p class="text-theme-secondary mb-0">{{ keysCtrl.formatDate(keysCtrl.viewingKey.lastUsedAt) }}</p>
                    </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/scripts/app/multi-select.directive.js"></script>
<script src="/scripts/app/api-keys.client.controller.js"></script>
<link rel="stylesheet" href="/css/apidoc.css">
<link rel="stylesheet" href="/css/post.css">
