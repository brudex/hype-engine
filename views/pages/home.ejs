<%- contentFor('body') %>

<!-- App Screenshots Carousel Section - Full Width -->
<section class="app-carousel-hero position-relative overflow-hidden">
    <div class="carousel-container-fluid">
                            <!-- Download Buttons Overlay -->
                    <div class="download-buttons-overlay">
                        <!-- Title with gradient overlay -->
                        <div class="carousel-title-overlay">
                            <div class="title-icon">
                                <i class="fas fa-trophy"></i>
                            </div>
                            <h2 class="carousel-title">Ace Your Next Professional Exam</h2>
                        </div>
                        
                        <div class="download-buttons">
                            <a href="/ios" class="store-button-link">
                                <img src="/images/appstore-button.svg.png" alt="Download on the App Store" class="store-button">
                            </a>
                            <a href="/android" class="store-button-link">
                                <img src="/images/googleplay-button.svg.webp" alt="Get it on Google Play" class="store-button">
                            </a>
                        </div>
                    </div>
        
        <!-- Carousel -->
        <div id="appCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
                <button type="button" data-bs-target="#appCarousel" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                <button type="button" data-bs-target="#appCarousel" data-bs-slide-to="1" aria-label="Slide 2"></button>
            </div>
            
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <div class="carousel-image-container">
                        <div class="screens-grid">
                            <div class="screen-item">
                                <img src="/images/appscreens/playstore/Playstore Screenshots - 01.jpg" alt="Quiz Factor App Screenshot 1">
                            </div>
                            <div class="screen-item">
                                <img src="/images/appscreens/playstore/Playstore Screenshots - 02.jpg" alt="Quiz Factor App Screenshot 2">
                            </div>
                        </div>
                    </div>
                </div>
                <div class="carousel-item">
                    <div class="carousel-image-container">
                        <div class="screens-grid">
                            <div class="screen-item">
                                <img src="/images/appscreens/playstore/Playstore Screenshots - 03.jpg" alt="Quiz Factor App Screenshot 3">
                            </div>
                            <div class="screen-item">
                                <img src="/images/appscreens/playstore/Playstore Screenshots - 04.jpg" alt="Quiz Factor App Screenshot 4">
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            
            <button class="carousel-control-prev" type="button" data-bs-target="#appCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#appCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button>
        </div>
    </div>
</section>
 
<!-- Features Section -->
<section class="py-5 bg-white" id="features">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="display-4 fw-bold text-primary mb-3">Why Choose Quiz Factor?</h2>
                <p class="lead text-muted">Discover the features that make us the preferred choice for professional certification preparation</p>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-4 col-md-6">
                <div class="feature-card h-100 p-4 text-center border-0 shadow-sm rounded-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-mobile-alt fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-primary mb-3">Mobile-First Learning</h4>
                    <p class="text-muted">Study anywhere, anytime with our mobile-optimized platform. Perfect for busy professionals on the go.</p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card h-100 p-4 text-center border-0 shadow-sm rounded-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-certificate fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-primary mb-3">Certificate Preparation</h4>
                    <p class="text-muted">Comprehensive quiz collections designed to help you prepare for professional certification exams.</p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card h-100 p-4 text-center border-0 shadow-sm rounded-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-chart-line fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-primary mb-3">Progress Tracking</h4>
                    <p class="text-muted">Monitor your learning journey with detailed analytics and performance insights.</p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card h-100 p-4 text-center border-0 shadow-sm rounded-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-user-graduate fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-primary mb-3">Expert Content</h4>
                    <p class="text-muted">High-quality questions created by industry experts and certified professionals.</p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card h-100 p-4 text-center border-0 shadow-sm rounded-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-clock fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-primary mb-3">Timed Practice</h4>
                    <p class="text-muted">Simulate real exam conditions with timed quizzes and practice tests.</p>
                </div>
            </div>
            
            <div class="col-lg-4 col-md-6">
                <div class="feature-card h-100 p-4 text-center border-0 shadow-sm rounded-4">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-analytics fa-3x text-primary"></i>
                    </div>
                    <h4 class="fw-bold text-primary mb-3">Performance Analytics</h4>
                    <p class="text-muted">Get detailed insights into your strengths and areas for improvement.</p>
                </div>
            </div>
        </div>
    </div>
</section>

