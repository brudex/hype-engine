<div class="page-header mb-0">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h4 class="m-b-5 text-theme-primary" ng-if="servicesCtrl.selectedProject">Services - {{ servicesCtrl.selectedProject.name }}</h4>
                    <h4 class="m-b-5 text-theme-primary" ng-if="!servicesCtrl.selectedProject">Services</h4>
                    <p class="text-theme-secondary mb-0" ng-if="servicesCtrl.selectedProject">Configure third-party API services for {{ servicesCtrl.selectedProject.name }}</p>
                    <p class="text-theme-secondary mb-0" ng-if="!servicesCtrl.selectedProject">Configure third-party API services for social media platforms</p>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item"><a href="/dashboard/projects">Projects</a></li>
                    <li class="breadcrumb-item" ng-if="servicesCtrl.selectedProject">
                        <a href="/dashboard/projects/{{ servicesCtrl.selectedProject.uuid }}">{{ servicesCtrl.selectedProject.name }}</a>
                    </li>
                    <li class="breadcrumb-item active">Services</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="main-body mt-0" ng-controller="ServicesController as servicesCtrl" ng-init="servicesCtrl.init('<%= typeof project !== 'undefined' ? project.uuid : '' %>')">
    <div class="page-wrapper">
        <div class="alert alert-info">
            <i class="bi bi-info-circle"></i> 
            <strong>Important:</strong> Configure services before connecting social accounts. Services store API credentials needed to connect accounts.
        </div>

        <!-- Project Selection -->
        <%- include('../partials/_project-selection', { controllerName: 'servicesCtrl', placeholder: '..Select Project..' }) %>

        <div ng-if="servicesCtrl.loading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
        </div>

        <!-- No Project Selected Message -->
        <div ng-if="!servicesCtrl.loading && !servicesCtrl.selectedProject" class="text-center py-5">
            <div class="alert alert-warning">
                <i class="bi bi-exclamation-triangle"></i>
                <h5 class="alert-heading">Select a Project</h5>
                <p class="mb-0">Please select a project from the dropdown above to configure services.</p>
            </div>
        </div>

        <!-- Services List -->
        <div ng-if="!servicesCtrl.loading && servicesCtrl.selectedProject">
            <h5 class="mb-3 text-theme-primary">
                <i class="bi bi-share"></i> Social Platform Services - {{ servicesCtrl.selectedProject.name }}
            </h5>
            <p class="text-secondary small mb-3">Configure OAuth applications for social media platforms</p>
            
            <div class="row">
                <div class="col-md-6 mb-4" ng-repeat="service in servicesCtrl.services">
                    <div class="card h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="card-title mb-1">
                                        <i class="bi" ng-class="{
                                            'bi-twitter text-primary': service.name === 'twitter',
                                            'bi-facebook text-primary': service.name === 'facebook',
                                            'bi-instagram text-danger': service.name === 'instagram',
                                            'bi-linkedin text-primary': service.name === 'linkedin',
                                            'bi-mastodon text-primary': service.name === 'mastodon',
                                            'bi-tiktok': service.name === 'tiktok',
                                            'bi-image': service.name === 'unsplash',
                                            'bi-file-play': service.name === 'tenor'
                                        }"></i> 
                                        {{ servicesCtrl.capitalize(service.name) }}
                                    </h5>
                                    <p class="text-secondary small mb-0 mt-2">Configure {{ service.name }} API credentials</p>
                                </div>
                                <span class="badge" ng-class="servicesCtrl.getServiceStatus(service)">
                                    {{ service.configured ? 'Configured' : 'Not Configured' }}
                                </span>
                            </div>
                            <p class="text-secondary small mt-0">
                                Required for connecting {{ service.name }} accounts.
                            </p>
                            <button class="btn btn-sm btn-outline-primary" ng-click="servicesCtrl.configureService(service.name)">
                                <i class="bi bi-gear"></i> Configure
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/scripts/app/services.client.controller.js"></script>
