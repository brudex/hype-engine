<!-- Create Tag Section -->
<div ng-if="apiDocCtrl.activeSection === 'create-tag'" class="api-doc-section">
    <div class="api-endpoint-header">
        <span class="badge badge-success">POST</span>
        <h2 class="api-doc-title">Create Tag</h2>
    </div>
    <p class="api-doc-description">
        Creates a new tag for organizing posts. The name must be unique within the project.
    </p>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Endpoint</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>URL</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('create-tag-url')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="create-tag-url">
                <pre><code>POST /api/v1/:projectUuid/tags</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Request Body</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Request Body</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('create-tag-body')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="create-tag-body">
                <pre><code>{
  "name": "Tag Name",
  "hex_color": "3B82F6"
}</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Request Fields</h3>
        <ul class="api-doc-list">
            <li><code>name</code> (required) - The tag name (must be unique within the project)</li>
            <li><code>hex_color</code> (optional) - Hex color code for the tag (e.g., "3B82F6")</li>
        </ul>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Response</h3>
        <p><strong>Success (201):</strong></p>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Success Response</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('create-tag-success')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="create-tag-success">
                <pre><code>{
  "success": true,
  "data": {
    "uuid": "tag-uuid",
    "name": "Tag Name",
    "hex_color": "3B82F6",
    "created_at": "2024-01-15T10:00:00Z"
  }
}</code></pre>
            </div>
        </div>
    </div>
</div>

