<!-- Form Fields -->
<div class="mb-3">
    <label for="client_id" class="form-label">Client ID <span class="text-danger">*</span></label>
    <input type="text" class="form-control" id="client_id" name="configuration[client_id]" required>
    <small class="form-text text-muted">Your TikTok Client ID</small>
</div>

<div class="mb-3">
    <label for="client_secret" class="form-label">Client Secret <span class="text-danger">*</span></label>
    <input type="password" class="form-control" id="client_secret" name="configuration[client_secret]" required>
    <small class="form-text text-muted">Your TikTok Client Secret</small>
</div>

<div class="mb-3">
    <button type="button" class="btn btn-outline-info" ng-click="configCtrl.testCredentials()" ng-disabled="configCtrl.testing">
        <i class="bi" ng-class="configCtrl.testing ? 'bi-hourglass-split' : 'bi-check-circle'"></i>
        {{ configCtrl.testing ? 'Testing...' : 'Test Credentials' }}
    </button>
    <small class="form-text text-muted d-block mt-1">Test if your API credentials are valid</small>
</div>

<!-- Help Section -->
<div class="card mt-3">
    <div class="card-body">
        <h6 class="card-title">How to get API credentials</h6>
        <ul class="small">
            <li>Go to <a href="https://developers.tiktok.com" target="_blank">TikTok Developers</a></li>
            <li>Create a new app or use an existing one</li>
            <li>Go to Basic Information</li>
            <li>Copy your Client Key (Client ID) and Client Secret</li>
        </ul>
    </div>
</div>
