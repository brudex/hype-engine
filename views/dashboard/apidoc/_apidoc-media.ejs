    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Endpoint</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>URL</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('update-media-url')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="update-media-url">
                <pre><code>PUT /api/v1/media/:mediaUuid</code></pre>
            </div>
        </div>
    </div>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Request Body</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>Request Body</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('update-media-body')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="update-media-body">
                <pre><code>{
  "name": "Updated Media Name"
}</code></pre>
            </div>
        </div>
    </div>
</div>

<!-- Delete Media Section -->
<div ng-if="apiDocCtrl.activeSection === 'delete-media'" class="api-doc-section">
    <div class="api-endpoint-header">
        <span class="badge badge-warning">DELETE</span>
        <h2 class="api-doc-title">Delete Media</h2>
    </div>
    <p class="api-doc-description">
        Permanently deletes a media file from your library. This action cannot be undone.
    </p>
    <div class="api-endpoint-detail">
        <h3 class="api-doc-subtitle">Endpoint</h3>
        <div class="code-block-wrapper">
            <div class="code-block-header">
                <span>URL</span>
                <button class="btn-copy" ng-click="apiDocCtrl.copyToClipboard('delete-media-url')" title="Copy to clipboard">
                    <i class="bi bi-clipboard"></i>
                </button>
            </div>
            <div class="code-block" id="delete-media-url">
                <pre><code>DELETE /api/v1/media/:mediaUuid</code></pre>
            </div>
        </div>
    </div>
    <div class="callout-box callout-warning">
        <i class="bi bi-exclamation-triangle"></i>
        <div>
            <strong>Warning:</strong> This action is irreversible. Make sure you want to delete the media file before making this request.
        </div>
    </div>
</div>

