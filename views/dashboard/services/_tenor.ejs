<!-- Form Fields -->
<div class="mb-3">
    <label for="api_key" class="form-label">API Key <span class="text-danger">*</span></label>
    <input type="text" class="form-control" id="api_key" name="configuration[api_key]" required>
    <small class="form-text text-muted">Your Tenor API Key</small>
</div>

<!-- Help Section -->
<div class="card mt-3">
    <div class="card-body">
        <h6 class="card-title">How to get API credentials</h6>
        <ul class="small">
            <li>Go to <a href="https://developers.google.com/tenor" target="_blank">Tenor API</a></li>
            <li>Get your API key from Google Cloud Console</li>
        </ul>
    </div>
</div>
