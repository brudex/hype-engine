<div class="page-header mb-0">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h4 class="m-b-5 text-theme-primary">Job Batches</h4>
                    <p class="text-theme-secondary mb-0">View and monitor background job execution</p>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/dashboard"><i class="bi bi-house-door"></i></a></li>
                    <li class="breadcrumb-item"><a href="/admin">Admin</a></li>
                    <li class="breadcrumb-item active">Jobs</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="main-body mt-0">
    <div class="page-wrapper">
        <div class="container-fluid">
            <!-- Filters -->
            <div class="card mb-4">
                <div class="card-body">
                    <form method="GET" action="/admin/jobs" class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Status</label>
                            <select name="status" class="form-select">
                                <option value="">All Status</option>
                                <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="completed" <%= filters.status === 'completed' ? 'selected' : '' %>>Completed</option>
                                <option value="failed" <%= filters.status === 'failed' ? 'selected' : '' %>>Failed</option>
                                <option value="cancelled" <%= filters.status === 'cancelled' ? 'selected' : '' %>>Cancelled</option>
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">&nbsp;</label>
                            <button type="submit" class="btn btn-primary w-100">Filter</button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Jobs Table -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Job Batches (<%= pagination.totalItems %>)</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>UUID</th>
                                    <th>Name</th>
                                    <th>Status</th>
                                    <th>Progress</th>
                                    <th>Total Jobs</th>
                                    <th>Pending</th>
                                    <th>Failed</th>
                                    <th>Created</th>
                                    <th>Finished</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (jobBatches.length === 0) { %>
                                    <tr>
                                        <td colspan="10" class="text-center">No job batches found</td>
                                    </tr>
                                <% } else { %>
                                    <% jobBatches.forEach(job => { %>
                                        <tr>
                                            <td><small><%= job.uuid.substring(0, 8) %>...</small></td>
                                            <td><%= job.name %></td>
                                            <td>
                                                <% if (job.finishedAt) { %>
                                                    <span class="badge bg-success">Completed</span>
                                                <% } else if (job.cancelledAt) { %>
                                                    <span class="badge bg-secondary">Cancelled</span>
                                                <% } else { %>
                                                    <span class="badge bg-primary">Active</span>
                                                <% } %>
                                                <% if (job.failedJobs > 0) { %>
                                                    <span class="badge bg-danger">Has Failures</span>
                                                <% } %>
                                            </td>
                                            <td>
                                                <% 
                                                    const completed = job.totalJobs - job.pendingJobs;
                                                    const progress = job.totalJobs > 0 ? Math.round((completed / job.totalJobs) * 100) : 0;
                                                %>
                                                <div class="progress" style="width: 100px;">
                                                    <div class="progress-bar" role="progressbar" style="width: <%= progress %>%" aria-valuenow="<%= progress %>" aria-valuemin="0" aria-valuemax="100">
                                                        <%= progress %>%
                                                    </div>
                                                </div>
                                            </td>
                                            <td><%= job.totalJobs %></td>
                                            <td><%= job.pendingJobs %></td>
                                            <td>
                                                <% if (job.failedJobs > 0) { %>
                                                    <span class="text-danger"><%= job.failedJobs %></span>
                                                <% } else { %>
                                                    <%= job.failedJobs %>
                                                <% } %>
                                            </td>
                                            <td><%= new Date(job.createdAt).toLocaleString() %></td>
                                            <td>
                                                <% if (job.finishedAt) { %>
                                                    <%= new Date(job.finishedAt).toLocaleString() %>
                                                <% } else if (job.cancelledAt) { %>
                                                    <%= new Date(job.cancelledAt).toLocaleString() %>
                                                <% } else { %>
                                                    -
                                                <% } %>
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-outline-primary" onclick="viewJobDetails('<%= job.uuid %>')">Details</button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    <% if (pagination.totalPages > 1) { %>
                        <nav aria-label="Jobs pagination">
                            <ul class="pagination justify-content-center mt-4">
                                <% if (pagination.currentPage > 1) { %>
                                    <li class="page-item">
                                        <a class="page-link" href="?page=<%= pagination.currentPage - 1 %><%= filters.status ? '&status=' + filters.status : '' %>">Previous</a>
                                    </li>
                                <% } %>
                                
                                <% for (let i = 1; i <= pagination.totalPages; i++) { %>
                                    <% if (i === pagination.currentPage) { %>
                                        <li class="page-item active">
                                            <span class="page-link"><%= i %></span>
                                        </li>
                                    <% } else if (i === 1 || i === pagination.totalPages || (i >= pagination.currentPage - 2 && i <= pagination.currentPage + 2)) { %>
                                        <li class="page-item">
                                            <a class="page-link" href="?page=<%= i %><%= filters.status ? '&status=' + filters.status : '' %>"><%= i %></a>
                                        </li>
                                    <% } else if (i === pagination.currentPage - 3 || i === pagination.currentPage + 3) { %>
                                        <li class="page-item disabled">
                                            <span class="page-link">...</span>
                                        </li>
                                    <% } %>
                                <% } %>
                                
                                <% if (pagination.currentPage < pagination.totalPages) { %>
                                    <li class="page-item">
                                        <a class="page-link" href="?page=<%= pagination.currentPage + 1 %><%= filters.status ? '&status=' + filters.status : '' %>">Next</a>
                                    </li>
                                <% } %>
                            </ul>
                        </nav>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Job Details Modal -->
<div class="modal fade" id="jobDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Job Batch Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="jobDetailsContent">
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
function viewJobDetails(uuid) {
    const modal = new bootstrap.Modal(document.getElementById('jobDetailsModal'));
    const content = document.getElementById('jobDetailsContent');
    
    content.innerHTML = '<div class="text-center"><div class="spinner-border" role="status"><span class="visually-hidden">Loading...</span></div></div>';
    modal.show();
    
    fetch('/admin/api/jobs/' + uuid)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                const job = data.data.jobBatch;
                content.innerHTML = `
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>UUID:</strong><br>
                            <small>${job.uuid}</small>
                        </div>
                        <div class="col-md-6">
                            <strong>Name:</strong><br>
                            ${job.name}
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <strong>Total Jobs:</strong> ${job.totalJobs}
                        </div>
                        <div class="col-md-4">
                            <strong>Pending:</strong> ${job.pendingJobs}
                        </div>
                        <div class="col-md-4">
                            <strong>Failed:</strong> ${job.failedJobs}
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <strong>Created:</strong><br>
                            ${new Date(job.createdAt).toLocaleString()}
                        </div>
                        <div class="col-md-6">
                            <strong>Finished:</strong><br>
                            ${job.finishedAt ? new Date(job.finishedAt).toLocaleString() : '-'}
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <strong>Progress:</strong>
                            <div class="progress">
                                <div class="progress-bar" role="progressbar" style="width: ${data.data.progress}%" aria-valuenow="${data.data.progress}" aria-valuemin="0" aria-valuemax="100">
                                    ${data.data.progress}%
                                </div>
                            </div>
                        </div>
                    </div>
                    ${job.failedJobIds && job.failedJobIds.length > 0 ? `
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <strong>Failed Job IDs:</strong>
                                <ul>
                                    ${job.failedJobIds.map(id => `<li>${id}</li>`).join('')}
                                </ul>
                            </div>
                        </div>
                    ` : ''}
                    ${job.options ? `
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <strong>Options:</strong>
                                <pre class="bg-light p-2 rounded">${JSON.stringify(job.options, null, 2)}</pre>
                            </div>
                        </div>
                    ` : ''}
                `;
            } else {
                content.innerHTML = '<div class="alert alert-danger">Error loading job details: ' + data.message + '</div>';
            }
        })
        .catch(error => {
            content.innerHTML = '<div class="alert alert-danger">Error: ' + error.message + '</div>';
        });
}
</script>
